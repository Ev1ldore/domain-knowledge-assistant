# 示例文件不会自动加载；在 shell 中 export 或使用 Docker Compose --env-file。
KB_ADMIN_USERNAME=admin
KB_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
# 本地 Ollama 不需要 API key；远程服务通过环境变量提供，绝不写进 INI。
LLM_API_KEY=
EMBEDDING_API_KEY=
# 按实际模型服务修改 URL、模型名。
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M:latest
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3:latest
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=cpu
RERANKER_BACKEND=cross_encoder
